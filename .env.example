# Papua Barat Monitoring System - Environment Variables

# Supabase Configuration (Optional - sistem otomatis menggunakan local database jika belum dikonfigurasi)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI API Key untuk Papua Barat Program Assistant (Opsional - fallback rule-based engine otomatis aktif jika kosong)
OPENAI_API_KEY=

# Mapbox Token (Opsional - default menggunakan Leaflet OpenStreetMap bebas lisensi)
NEXT_PUBLIC_MAPBOX_TOKEN=

# App Environment
NEXT_PUBLIC_APP_NAME="Papua Barat Monitoring System"
NEXT_PUBLIC_APP_TIMEZONE="Asia/Jayapura"
